---
/* Classes: panel, panel-head, panel-tag, kv, kv-label, kv-value, board-meta, btn, btn-primary, note, muted */
import { boardSummary, withBase, type Board } from "../lib/project";
import { site } from "../content/site";
import Panel from "./Panel.astro";
import KeyValue from "./KeyValue.astro";
interface Props {
  board: Board;
  version: string;
  hidden?: boolean;
}
const { board, version, hidden = false } = Astro.props;
const manifest = withBase(`firmware/${board.manifest}`);
---

<div id={`install-${board.id}`} data-install-for={board.id} hidden={hidden}>
  <Panel tag="Install" title={board.label}>
    <p class="board-meta">{boardSummary(board)}</p>
    <KeyValue
      items={[
        { label: "Version", value: version },
        { label: "Chip", value: board.chip },
      ]}
    />
    <esp-web-install-button manifest={manifest}>
      <button slot="activate" type="button" class="btn btn-primary">
        Install {board.label}
      </button>
      <p slot="unsupported" class="note">
        This browser cannot flash over USB. Use a Chromium-based browser with Web Serial, such as Chrome, Edge or Opera.
      </p>
      <p slot="not-allowed" class="note">
        Web Serial needs a secure page. Open this site over HTTPS.
      </p>
    </esp-web-install-button>
    <p class="muted">
      {site.settingsNote}
    </p>
  </Panel>
</div>

<script>
  import "esp-web-tools/dist/web/install-button.js";
</script>
