---
/* Classes: disclosure */
import Disclosure from "./Disclosure.astro";
import Section from "./Section.astro";
interface Props {
  faq: { q: string; a: string }[];
}
const { faq } = Astro.props;
---

<Section id="troubleshooting" title="Troubleshooting">
  {
    faq.map((item) => (
      <Disclosure summary={item.q}>
        <p>{item.a}</p>
      </Disclosure>
    ))
  }
</Section>
